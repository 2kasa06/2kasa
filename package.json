{
  "name": "beauty-produce-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "美容プロデュースサービス公式サイト (Vite + React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:preview": "vite build --config vite.preview.config.ts && node scripts/build-preview.mjs",
    "news:build": "node news/build.mjs",
    "news:dry": "node news/build.mjs --dry-run",
    "news:test": "node news/selftest.mjs",
    "news:preview": "node news/preview.mjs",
    "news:map": "node news/tools/build-map.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@svg-maps/japan": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
