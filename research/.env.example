# ここにある値をコピーして .env.local（Next.js）と .env（Prisma CLI）を作る。
# .env* はコミットしない。API キーはサーバ側でだけ使い、ブラウザには渡さない。

# データの提供元。現在は mock のみ（実データの提供元は src/lib/providers に実装して追加する）
DATA_SOURCE=mock

# PostgreSQL。未設定でも画面はモックで動く（DB はシード・今後のウォッチリストで使う）
# docker compose up -d で立ち上げた場合:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research?schema=public

# 実データの提供元の鍵（提供元の利用規約・再配布条件を確認してから使う）
MARKET_DATA_API_KEY=
NEWS_API_KEY=
FINANCIAL_DATA_API_KEY=

# AI 要約（PHASE 5）
ANTHROPIC_API_KEY=

# キャッシュを複数台で共有するとき（未設定ならプロセス内メモリ）
REDIS_URL=

# API のレート制限（1分あたり・IPごと）
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
